# Copy to .env (or .env.staging and run with TEST_ENV=staging).
# Defaults in src/config/env.ts point at public demo apps so the starter runs as-is.

# Web app under test
BASE_URL=https://www.saucedemo.com
# Attribute your app uses for test ids: data-testid | data-test | data-qa
TEST_ID_ATTRIBUTE=data-test
UI_USERNAME=standard_user
UI_PASSWORD=secret_sauce

# API under test
API_URL=https://dummyjson.com
API_USERNAME=emilys
API_PASSWORD=emilyspass

# Set to 1 to add Firefox + WebKit projects
CROSS_BROWSER=0
